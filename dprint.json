{
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "json": {
  },
  "markdown": {
    "textWrap": "always"
  },
  "toml": {
  },
  "yaml": {
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "rustfmt --edition 2024",
      "exts": ["rs"],
      "cacheKeyFiles": [
        "rustfmt.toml",
        "rust-toolchain.toml",
      ],
    }],
  },
  "excludes": [
    "**/.git",
    "**/.pixi",
    "**/.task",
    "**/apm_modules",
    "pixi.lock",
    "bun.lock",
    "apm.lock.yaml",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d"
  ]
}
