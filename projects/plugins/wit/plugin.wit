package doup:plugin@0.1.0;

/// Types shared by every plugin world.
interface types {
  /// The broad category of a `guest-error`, lets the host react to a failure without parsing messages.
  enum error-kind {
    /// The config passed to `configure` is invalid, or the plugin has not been configured.
    invalid-config,

    /// An argument passed to an export is invalid, eg: a malformed version number.
    invalid-input,

    /// The workspace holds something the plugin can't understand, eg: a malformed manifest or lockfile.
    invalid-workspace,

    /// Something the export needed does not exist, eg: a repository, registry or package.
    not-found,

    /// An HTTP request failed or returned an unsuccessful status.
    http,

    /// A remote service, or the host, responded with something the plugin could not understand.
    invalid-response,

    /// Reading or writing the workspace (or any other file) failed.
    io,

    /// Running a container through `host-api.run` failed.
    container,

    /// Anything else.
    other,
  }

  /// The error returned by every plugin export.
  ///
  /// WIT has no recursive types, so rather than nesting errors the chain of causes is flattened
  /// into `causes`. The host rebuilds it into a regular error chain.
  record guest-error {
    kind: error-kind,

    /// Describes only this error's own context, eg: "failed to read Cargo.toml".
    message: string,

    /// The underlying causes, outermost first, eg: ["No such file or directory (os error 2)"].
    causes: list<string>,
  }
}

interface host-api {
  host-version: func() -> string;

  record run-request {
    /// The image to run, eg: "docker.io/library/rust:slim". The tag defaults to `latest`.
    image: string,

    /// Overrides the image's entrypoint.
    entrypoint: option<string>,

    /// The command to run, as an argv list. There is no implicit shell, use eg:
    /// `["sh", "-c", "..."]` or `["sh", "/container-init/script.sh"]` if you need one.
    command: list<string>,

    /// Extra environment variables for the command.
    env: list<tuple<string, string>>,

    /// The working directory of the command, defaults to `/workspace`.
    working-dir: option<string>,
  }

  record run-output {
    stdout: string,
    stderr: string,
  }

  /// The outcome of a container whose command did not exit successfully.
  record run-exit {
    /// The exit code, none if the container runtime could not report one.
    code: option<s64>,
    stdout: string,

    /// The tail of stderr, the host truncates it to keep the error a reasonable size.
    stderr: string,
  }

  /// Why `run` failed.
  variant run-error {
    /// Containers are not permitted for the current call.
    not-permitted,

    /// The request is invalid, eg: an empty `command`.
    invalid-request(string),

    /// The container could not be run, eg: the runtime is unavailable or the image can't be pulled.
    runtime(string),

    /// The command ran but exited with a non-zero (or unknown) code.
    exited(run-exit),
  }

  /// Runs a short lived container, managed by the host, to completion & returns its output.
  ///
  /// This keeps the guest sandboxed while letting it lean on real tooling (eg: `cargo update`)
  /// rather than re-implementing it in WASM. Only some exports are permitted to call it, see the
  /// docs of each export, every other call gets an error.
  ///
  /// Three directories are mounted into the container:
  ///
  /// - `/workspace`: the guest's own `/workspace`, with the same permissions.
  ///
  /// - `/container-init`: the guest's own `/container-init`, read-only. Write scripts, config, etc
  ///   there first so they don't end up in the workspace (& accidentally committed). WASI can't set
  ///   the executable bit so run scripts through an interpreter, eg: `sh /container-init/run.sh`.
  ///
  /// - `/container-cache`: read-write & shared by every container run through the same plugin, it
  ///   outlives a single call. Point a tool's cache at it (eg: `CARGO_HOME`) to avoid re-downloading
  ///   things on each run. The guest can't read or write it directly. Treat it purely as an
  ///   optimisation, it may be empty at any time & concurrent containers may use it at once.
  ///
  /// The command runs as the owner of the workspace, so `HOME` may not be writable.
  ///
  /// Returns an error if containers are not permitted for the current call, the request is invalid,
  /// the container runtime is unavailable, the image can't be pulled, or the command exits with a
  /// non-zero code, see `run-error`.
  run: async func(request: run-request) -> result<run-output, run-error>;
}

/// Host-only world used to generate the shared host bindings.
world shared {
  import types;
  import host-api;
}

world platform {
  import host-api;
  use types.{guest-error};

  record pull-request {
    /// The pull request number.
    /// eg: `https://github.com/<owner>/<repo>/pull/<number>`
    number: s64,

    /// The URL where a human can view the pull request.
    /// eg: `https://github.com/<owner>/<repo>/pull/<number>`
    url: string,

    /// The head branch of the PR.
    /// eg: `doup/{{ecosystem}}/{{name}}`
    head-branch: string,

    /// The branch the PR will be merged into, eg: `main`.
    base-branch: string,

    /// The version number that this pull request is updating to.
    /// This should be a plain version number without any semver constraints. eg: "1.2.3".
    /// Although does not strictly need to be a semver and remains largely opaque to the host.
    /// When a PR is created this value comes from either `versions.next` or `versions.latest`.
    /// But it up to the platform plugin as to how this value is actually encoded into the PR.
    /// eg: PR Title or other means.
    version: string,
  }

  /// The parts of a pull request that doup controls, used to both create & update a PR.
  record pull-request-content {
    /// The branch the PR will be merged into, eg: `main`.
    base-branch: string,

    /// The title of the PR.
    title: string,

    /// The body (description) of the PR, as markdown.
    /// The platform may truncate it to fit within its own limits.
    body: string,

    /// The version number that this pull request is updating to, see `pull-request.version`.
    /// The platform must encode it so that it is returned as `pull-request.version` by every export.
    version: string,
  }

  /// Called once, before any other export, with the repo config's `with` as a JSON object string.
  ///
  /// Its only job is to parse & validate that config and keep the result in the component's own memory
  /// for later exports to use, returning a `guest-error` if the config is invalid.
  ///
  /// It must remain pure. The host grants it no I/O at all, regardless of what any later export is
  /// allowed: no HTTP, no containers, no filesystem, not even stdout or stderr. Attempts fail, so anything
  /// that needs I/O (eg: logging, looking something up) belongs in the other exports. The host only
  /// grants a session its capabilities once this has returned.
  export configure: func(config: string) -> result<_, guest-error>;

  /// Opens a new pull request from `head-branch`, which has already been pushed, using `content`.
  export create-pr: async func(head-branch: string, content: pull-request-content) -> result<pull-request, guest-error>;

  /// Replaces the base branch, title, body & version of the open pull request `number` with `content`.
  /// The head branch of a pull request can not be changed, push to it instead.
  export update-pr: async func(number: s64, content: pull-request-content) -> result<pull-request, guest-error>;

  /// Closes the pull request `number` without merging it, returning it as it is once closed.
  /// Closing a pull request that is already closed is not an error.
  ///
  /// When `comment` is given (& is not blank) it is first posted to the pull request, as markdown,
  /// to explain why it is being closed. If posting it fails the pull request is left open.
  export close-pr: async func(number: s64, comment: option<string>) -> result<pull-request, guest-error>;

  /// List all open pull requests where their head branch name starts with `head-branch-prefix`.
  export list-open-prs: async func(head-branch-prefix: string) -> result<list<pull-request>, guest-error>;

  /// List all closed pull requests where their head branch exactly matches one of `head-branches`.
  export list-closed-prs: async func(head-branches: list<string>) -> result<list<pull-request>, guest-error>;
}

world ecosystem {
  import host-api;
  use types.{guest-error};

  record dependency {
    /// The name of the dependency, unique within this ecosystem, eg: "@types/node".
    name: string,

    /// The registry the dependency is resolved from, opaque to the host and defined by the ecosystem,
    /// eg: the index URL of an alternate cargo registry. None means the ecosystem's default registry.
    ///
    /// The same name from different registries are different dependencies,
    /// so a dependency is unique within this ecosystem by the pair (name, registry).
    registry: option<string>,

    /// A dependency may occur many times, think monorepo with
    /// many manifests that all depend on a common dependency.
    occurrences: list<occurrence>,

    /// The doup host needs to know what the canonical "current" version is for
    /// a given dependency. In order to do things like write comment messages
    /// of the form: "chore(bump): {{name}} from {{current}} to {{next}}".
    ///
    /// But if there are multiple occurrences, it's difficult for the host to reliably know which one to use.
    /// Instead we expect the guest to fill this value, usually this would be the lowest locked-version.
    /// Or if locked is not available, the lowest current-version but in pure semver form without any constraints,
    /// just the version number, eg: "1.2.3".
    ///
    /// This value is still by & large opaque to the host & does not nessarily
    /// need to be a semantic version number, it is used for identification of
    /// PRs & display purposes, like the commit message example.
    current-version: string,
  }

  record occurrence {
    /// Manifest path relative to the workspace root, eg: "apps/web/package.json".
    manifest-path: string,

    /// Lockfile path relative to the workspace root, eg: "apps/web/package-lock.json".
    /// Not all ecosystems have a lockfile so this is optional.
    lock-path: option<string>,

    /// Version as currently declared, eg: "^1.2.3". Opaque to the host.
    current-version: string,

    /// The version as locked by lock-path, eg: "1.2.3". Opaque to the host.
    /// No lockfile, then this will also be none.
    locked-version: option<string>,
  }

  record versions {
    /// The latest version that still satisfies any version constraints from the original manifest.
    /// eg: If current-version is ^1.2.3 then this value must be  less than 2.0.0
    next: string,

    /// The very latest version regardless of any original version constraints.
    /// If this would be the same value as `next` there is no need to supply this.
    /// Setting this to a value will end up creating a second PR that maintainers
    /// may elect to merge over the PR created for the `next` version.
    latest: option<string>,
  }

  record release-note {
    /// The version number for this release note.
    ///
    /// Opaque to the host but typically a semver - eg: "1.2.3".
    /// Every release-note should have a unique version, consider this field to
    /// be it's primary identity, with-in the context of a given dependency.
    version: string,

    /// The URL where the full release notes can be found.
    ///
    /// If this points at a file that contains release notes for several versions, eg: CHANGELOG.md
    /// Then ideally use HTML anchors where possible to link to the relevant part of the document.
    url: string,

    /// The full body of the release notes for this specific version.
    ///
    /// To clarify if the URL pointed at a single CHANGELOG.md, the value here
    /// would be a sub-string of the full document, not the entire document with
    /// all versions ever released.
    body: string,
  }

  /// Called once, before any other export, with the repo config's `with` as a JSON object string.
  ///
  /// Its only job is to parse & validate that config and keep the result in the component's own memory
  /// for later exports to use, returning a `guest-error` if the config is invalid.
  ///
  /// It must remain pure. The host grants it no I/O at all, regardless of what any later export is
  /// allowed: no HTTP, no containers, no filesystem, not even stdout or stderr. Attempts fail, so anything
  /// that needs I/O (eg: logging, looking something up) belongs in the other exports. The host only
  /// grants a session its capabilities once this has returned.
  export configure: func(config: string) -> result<_, guest-error>;

  /// Returns a list of dependencies discovered in the current workspace.
  /// Async because under WASI p3 a guest may only block on I/O (eg: reading the workspace) from an async task.
  export discover-deps: async func() -> result<list<dependency>, guest-error>;

  /// Looks up the latest version for a given dependency.
  /// If the latest version matches what is already installed then return `None`.
  export lookup-versions: async func(dependency: dependency) -> result<option<versions>, guest-error>;

  /// Downloads release notes for every version between the dependencies lowest recorded version & `to`.
  /// Where `to` is `versions.latest` if returned by `lookup-versions`, otherwise `versions.next`.
  export fetch-release-notes: async func(dependency: dependency, to: string) -> result<list<release-note>, guest-error>;

  /// Updates every occurrence of `dependency` in the workspace to version `to`.
  /// Where `to` is either `versions.next` or `versions.latest` as returned by `lookup-versions`.
  ///
  /// The guest is given read-write access to the workspace (a fresh git worktree mounted at
  /// `/workspace`) & may make HTTP calls. It is expected to edit manifests & lockfiles in place,
  /// the host then commits whatever changed.
  ///
  /// This is the only export that may call `host-api.run`. It is also given an empty, read-write
  /// `/container-init` directory, scratch space for files to mount into those containers.
  export apply-updates: async func(dependency: dependency, to: string) -> result<_, guest-error>;
}
